{
  "name": "goodalex223-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio website for Alexey Minakov",
  "scripts": {
    "build": "npm run build:css && npm run hash:css",
    "build:css": "postcss css/main.css --output dist/style.css --env production",
    "hash:css": "node scripts/hash-css.js",
    "watch": "node scripts/hash-css.js --unhash && postcss css/main.css --output dist/style.css --watch",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:css:fix": "stylelint \"css/**/*.css\" --fix"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "cssnano": "^7.1.2",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "stylelint": "^17.3.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
